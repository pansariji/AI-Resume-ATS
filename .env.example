# =================================================================
# ATS Resume Scorer - Environment Variables
# =================================================================
# Copy this file to .env:
#     copy .env.example .env     (Windows PowerShell / Command Prompt)
#     cp .env.example .env       (Linux / Mac)
# =================================================================

# -----------------------------------------------------------------
# 1. GROQ API (Required for LLM parsing & suggestions)
# Get a free key at: https://console.groq.com/keys
# -----------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------
# 2. SUPABASE (Required for Auth & Analysis History)
# Create a free project at: https://supabase.com
# Find these in: Project Settings -> API
# -----------------------------------------------------------------
# Project URL (e.g. https://abcdefghijklm.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key (used by frontend for auth)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key (used by backend for saving analysis records)
SUPABASE_KEY=your_supabase_service_role_key_here

# JWT Secret (used by backend to verify user tokens)
# Found in: Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# -----------------------------------------------------------------
# 3. OPTIONAL SETTINGS
# -----------------------------------------------------------------
# Google OAuth redirect URL (defaults to http://localhost:8501)
AUTH_REDIRECT_URL=http://localhost:8501

# Sentence transformer model for semantic embeddings (default: all-MiniLM-L6-v2)
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
